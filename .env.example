# Stack-level deployment variables — interpolated by compose.yml and
# compose.override.yml only. Tune's application configuration lives in the
# dedicated per-service file tune/config/tune.env (copy from
# tune/config/tune.env.example), so these variables never overlap with the
# application's or with other stacks sharing this project directory.
# Copy this file to .env (gitignored) and fill in real values.
# Non-root runtime identity; mounted state directories must be writable by these IDs.
PUID=1000
PGID=1000
# Host ports publish on every host interface (no bind address — dynamic/DHCP
# host addresses just work). Point clients at the host's current address.
HTTPPROXY_PUBLISHED_PORT=8888
SOCKS5_PUBLISHED_PORT=1080
# Optional: override the pulled/built image tag. Default is the Cargo.toml
# version (CI tags the published image from it). Uncomment to pin or roll back.
# TUNE_IMAGE_TAG=0.1.0