# Tune application configuration — dedicated per-service environment file.
# Compose loads this file only into the tune service (env_file:), never from
# the project-level .env, so these variables cannot overlap with other stacks
# sharing the same Compose project directory. Copy to tune/config/tune.env
# (gitignored) and fill in real values. Deployment-only variables
# (PUID/PGID, PROXY_BIND_ADDRESS, *_PUBLISHED_PORT) live in .env — see
# .env.example.
WIREGUARD_PRIVATE_KEY=replace-with-a-valid-private-key
WIREGUARD_ADDRESSES=replace-with-addresses-from-your-mullvad-wireguard-config
WIREGUARD_QUANTUM_RESISTANT=on
SERVER_COUNTRIES=
DNS_UPSTREAM_RESOLVERS=mullvad
UPDATER_PERIOD=24h
PUBLICIP_ENABLED=on
STORAGE_SERVERS_ENABLED=on
HTTP_CONTROL_SERVER_API_KEY=replace-with-a-strong-api-key
HTTPPROXY=on
# Set off to disable the SOCKS5 listener; the HTTP proxy remains independent.
SOCKS5=on
# HTTP proxy Basic authentication is optional: leave HTTPPROXY_USER and
# HTTPPROXY_PASSWORD both blank for no authentication; setting either requires
# both. Basic credentials are base64-encoded, not encrypted — pair them with
# a TLS frontend or restrict them to trusted networks.
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=
# SOCKS5 username/password authentication is optional the same way: leave
# both blank for no authentication; setting either requires both.
SOCKS5_USER=
SOCKS5_PASSWORD=
# Client IP CIDRs allowed to use SOCKS5 UDP ASSOCIATE; empty allows all.
# SOCKS5 UDP requires a published UDP port and a reachable advertised address:
# set this to PROXY_BIND_ADDRESS:SOCKS5_PUBLISHED_PORT when publishing on a LAN.
SOCKS5_ALLOWED_CIDRS=
SOCKS5_UDP_ADVERTISED_ADDRESS=
# Ports other containers sharing Tune's network namespace may be reached on
# through the default-route interfaces; empty disables the exception.
FIREWALL_INPUT_PORTS=
# Other optional variables (server selection, Shadowsocks, DNS, health,
# metrics) are documented in README.md and parsed in src/config.rs.